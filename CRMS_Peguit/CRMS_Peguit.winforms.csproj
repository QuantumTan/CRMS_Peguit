<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>$(NoWarn);NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CRMS_Peguit.domain\CRMS_Peguit.domain.csproj" />
		<ProjectReference Include="..\CRMS_Peguit.infrastructure\CRMS_Peguit.infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="QuestPDF" Version="2026.9.0" />
		<PackageReference Include="ReaLTaiizor" Version="3.8.2.1" />
		<PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Assets\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="db.local.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<EmbeddedResource Include="Assets\**" />
	</ItemGroup>

</Project>